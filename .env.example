# このファイルをコピーして .env を作り、値を入れる（.env は GitHub に上げない）

# スプレッドシートの ID（URL の /d/ と /edit の間の文字列）
SPREADSHEET_ID=

# 手元で動かすとき：サービスアカウントの鍵ファイルの場所
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# 公開先（Vercel）では、ファイルの代わりに鍵の中身（JSON 全体）を入れる
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 毎朝の LINE 通知（Vercel にだけ入れる。手元では不要）
# LINE_CHANNEL_ACCESS_TOKEN=   LINE Developers の Messaging API 設定で発行する「チャネルアクセストークン（長期）」
# LINE_USER_ID=                チャネル基本設定の「あなたのユーザーID」（U で始まる）
# CRON_SECRET=                 自動実行（Vercel Cron）だけが通知を送れるようにする合言葉（長いランダムな文字）
