# このファイルをコピーして .env を作り、値を入れる（.env は GitHub に上げない）

# スプレッドシートの ID（URL の /d/ と /edit の間の文字列）
SPREADSHEET_ID=

# 手元で動かすとき：サービスアカウントの鍵ファイルの場所
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# 公開先（Vercel）では、ファイルの代わりに鍵の中身（JSON 全体）を入れる
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ログイン（scripts/setup_login.py で設定する。手で書くときも値はここに書かない）
# ALLOWED_EMAILS=          ログインを許可するメールアドレス（カンマ区切り）
# LOGIN_PASSWORD_HASH=     パスワードのハッシュ
# SECRET_KEY=              ログイン状態のクッキーの署名用の鍵
# GOOGLE_CLIENT_ID=        Google ログイン用
# GOOGLE_CLIENT_SECRET=    Google ログイン用
